:IMHELP NAME='COMMON/CRTFILE'.
:ehelp.
:help name='QSHQRYTMP/MBROPT'.
:IMHELP NAME='COMMON/CPYFMBROPT'.
:ehelp.
:help name='QSHQRYTMP/PROMPTCPYF'.
:IMHELP NAME='COMMON/PROMPTCPYF'.
:ehelp.
:help name='QSHQRYTMP/CLRAFTCPYF'.
:IMHELP NAME='COMMON/CLRAFTCPYF'.
:ehelp.
:help name='QSHQRYSRC/CPYRESULTS'.
:IMHELP NAME='COMMON/CPYRESULTS'.
:ehelp.
:help name='QSHQRYSRC/CPYTOFILE'.
:IMHELP NAME='COMMON/CPYTOFILE'.
:ehelp.
:help name='QSHQRYSRC/CRTFILE'.
:IMHELP NAME='COMMON/CRTFILE'.
:ehelp.
