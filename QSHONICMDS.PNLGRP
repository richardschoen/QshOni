:ehelp.
:help name='QSHPYCALL/DEBUGCMD'.
:IMHELP NAME='COMMON/DEBUGEXEC'.
:ehelp.
:help name='QSHPYCALL/CHGSCRDIR'.
:IMHELP NAME='COMMON/CHGSCRDIR'.
:ehelp.
:help name='QSHPYCALL/RETURN01'.
