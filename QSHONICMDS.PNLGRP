:IMHELP NAME='COMMON/IFSOPT'.
:ehelp.
:help name='QSHPHPRUN/CCSID'.
:IMHELP NAME='COMMON/CCSID37'.
:ehelp.
:help name='QSHPHPRUN/PRTSPLF'.
:IMHELP NAME='COMMON/PRTSPLF'.
:ehelp.
:help name='QSHPHPRUN/PRTUSRDTA'.
:IMHELP NAME='COMMON/PRTUSRDTA'.
:ehelp.
:help name='QSHPHPRUN/PRTTXT'.
:IMHELP NAME='COMMON/PRTTXT'.
:ehelp.
:help name='QSHPHPRUN/PRTHOLD'.
:IMHELP NAME='COMMON/PRTHOLD'.
:ehelp.
:help name='QSHPHPRUN/PRTOUTQ'.
:IMHELP NAME='COMMON/PRTOUTQ'.
:ehelp.
:help name='QSHPHPRUN/OUTFILE'.
:IMHELP NAME='COMMON/OUTFILE'.
:ehelp.
:help name='QSHPHPRUN/MBROPT'.
:IMHELP NAME='COMMON/MBROPT'.
:ehelp.
